# Salin file ini menjadi `.env.local` lalu isi nilainya. JANGAN commit .env.local.
# Semua variabel VITE_* akan terlihat di browser — hanya isi nilai yang memang publik.

# Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
# "anon" / "publishable" key (BOLEH di frontend karena data dilindungi RLS)
VITE_SUPABASE_ANON_KEY=eyJ...

# OPSIONAL — hanya untuk notifikasi push saat browser tertutup (lihat docs/NOTIFICATIONS.md)
# Kunci PUBLIK VAPID. Kunci privatnya hanya disimpan sebagai secret Edge Function, bukan di sini.
VITE_VAPID_PUBLIC_KEY=

# ------------------------------------------------------------------------------------------
# JANGAN PERNAH menaruh service_role key di file ini atau di Vercel env VITE_*.
# service_role hanya ada di Supabase (Edge Function secrets), tidak pernah di frontend.
# ------------------------------------------------------------------------------------------
