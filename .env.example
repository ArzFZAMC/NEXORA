# ===== FRONTEND (.env.local dan Vercel/Netlify Environment Variables) — hanya nilai PUBLIK =====
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
# Kunci PUBLIK VAPID (hasil `npx web-push generate-vapid-keys`, bagian Public Key)
VITE_VAPID_PUBLIC_KEY=

# ===== BACKEND: Supabase Edge Function SECRETS (JANGAN taruh di frontend/.env.local/Vercel) =====
# Atur dengan: npx supabase secrets set NAMA=nilai ...
# VAPID_PUBLIC_KEY=<sama dengan VITE_VAPID_PUBLIC_KEY>
# VAPID_PRIVATE_KEY=<Private Key dari generate-vapid-keys — RAHASIA>
# VAPID_SUBJECT=mailto:emailkamu@contoh.com
# CRON_SECRET=<string acak >= 16 karakter; nilai sama dengan yang disimpan di Vault (cron.sql)>
# ALLOWED_ORIGINS=https://domain-kamu.vercel.app,http://localhost:5173
# SUPABASE_URL dan SUPABASE_SERVICE_ROLE_KEY disediakan otomatis oleh Supabase untuk Edge Function.
